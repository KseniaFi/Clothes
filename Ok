                },
                audio: "videos/J-20251125184120836Z.mp3",
                type: "feet",
                isPair: true
            }
        ];

        // State variables
        let currentItemIndex = 0;
        let score = 0;
        let activeItems = [];
        let backgroundMusic = null;
        let clothingAudio = null;
        let fireworksInterval = null;
        let isWaitingForAnswer = false;
        let isPausedForFeedback = false;

        // DOM elements
        const gameArea = document.getElementById('gameArea');
        const scoreDisplay = document.getElementById('score');
        const speaker = document.getElementById('speaker');
        const clothingSpeaker = document.getElementById('clothingSpeaker');
        const arrowHint = document.getElementById('arrowHint');
        const volumeControl = document.getElementById('volumeControl');
        const volumeSlider = document.getElementById('volumeSlider');
        const feedbackOverlay = document.getElementById('feedbackOverlay');
        const correctFeedback = document.getElementById('correctFeedback');
        const itemNameFeedback = document.getElementById('itemNameFeedback');
        const restartBtn = document.getElementById('restartBtn');

        // Initialize
        function init() {
            // Start the game
            startGame();
            
            // Event handlers
            speaker.addEventListener('click', toggleBackgroundMusic);
            clothingSpeaker.addEventListener('click', startNextWord);
            volumeSlider.addEventListener('input', adjustVolume);
            restartBtn.addEventListener('click', restartGame);
            
            // Start fireworks
            startFireworks();
        }

        // Start the game
        function startGame() {
            // Create all flying clothing items
            createAllFlyingItems();
            
            // Start with the first word
            startNextWord();
        }

        // Restart the game
        function restartGame() {
            // Reset game state
            currentItemIndex = 0;
            score = 0;
            activeItems = [];
            scoreDisplay.textContent = `Score: ${score}`;
            
            // Clear game area
            clearFlyingItems();
            
            // Remove feedback overlay if visible
            feedbackOverlay.style.display = 'none';
            
            // Restart the game
            startGame();
        }

        // Create all flying clothing items
        function createAllFlyingItems() {
            // Clear existing items
            clearFlyingItems();
            
            // Create positions for items to be evenly distributed
            const positions = generateEvenPositions(clothingItems.length);
            
            // Create all clothing items
            for (let i = 0; i < clothingItems.length; i++) {
                const item = clothingItems[i];
                const position = positions[i];
                
                createFlyingItem(item, position.x, position.y);
            }
        }

        // Generate evenly distributed positions
        function generateEvenPositions(count) {
            const positions = [];
            const rows = Math.ceil(Math.sqrt(count));
            const cols = Math.ceil(count / rows);
            
            const areaWidth = gameArea.offsetWidth - 120;
            const areaHeight = gameArea.offsetHeight - 120;
            
            for (let i = 0; i < count; i++) {
                const row = Math.floor(i / cols);
                const col = i % cols;
                
                const x = (col * areaWidth / (cols - 1)) + 60;
                const y = (row * areaHeight / (rows - 1)) + 60;
                
                positions.push({ x, y });
            }
            
            return positions;
        }

        // Create a flying clothing item
        function createFlyingItem(item, x, y) {
            // Create the element
            const itemElement = document.createElement('div');
            itemElement.className = 'clothing-item';
            
            // For paired items, show only one item in the game
            if (item.isPair) {
                // Show left item by default in the game
                itemElement.style.backgroundImage = `url('${item.images.left}')`;
            } else {
                itemElement.style.backgroundImage = `url('${item.image}')`;
            }
            
            // Set position
            itemElement.style.left = `${x}px`;
            itemElement.style.top = `${y}px`;
            
            // Set random animation
            const duration = 15 + Math.random() * 10;
            itemElement.style.animation = `flyAround ${duration}s linear infinite`;
            
            // Add click event
            itemElement.addEventListener('click', () => handleItemClick(itemElement, item));
            
            // Store reference
            itemElement.dataset.itemName = item.name;
            
            // Add to game area and active items
            gameArea.appendChild(itemElement);
            activeItems.push({
                element: itemElement,
                name: item.name
            });
        }

        // Handle click on clothing item
        function handleItemClick(itemElement, item) {
            if (!isWaitingForAnswer || isPausedForFeedback) return;
            
            // Check if this is the correct item
            if (item.name === clothingItems[currentItemIndex].name) {
                // Correct answer
                itemElement.classList.add('correct');
                score++;
                scoreDisplay.textContent = `Score: ${score}`;
                
                // Pause the game for feedback
                isPausedForFeedback = true;
                
                // Show correct feedback with overlay
                showCorrectFeedback(item);
                
                // Remove the correct item from the game
                setTimeout(() => {
                    itemElement.remove();
                    activeItems = activeItems.filter(activeItem => activeItem.element !== itemElement);
                    
                    // Move to next word after a short delay
                    setTimeout(() => {
                        currentItemIndex++;
                        if (currentItemIndex < clothingItems.length) {
                            startNextWord();
                        } else {
                            // Game completed
                            setTimeout(() => {
                                alert("Congratulations! You've completed the game!");
                            }, 500);
                        }
                        isPausedForFeedback = false;
                    }, 500);
                }, 1500);
            } else {
                // Incorrect answer
                itemElement.classList.add('incorrect');
                
                // Remove the class after animation
                setTimeout(() => {
                    itemElement.classList.remove('incorrect');
                }, 1500);
            }
        }

        // Show correct feedback with overlay
        function showCorrectFeedback(item) {
            // Clear previous content
            correctFeedback.innerHTML = '';
            
            // Set the item name
            itemNameFeedback.textContent = item.name;
            
            // For paired items, show both items
            if (item.isPair) {
                const leftItem = document.createElement('div');
                leftItem.className = 'correct-feedback-item';
                leftItem.style.backgroundImage = `url('${item.images.left}')`;
                
                const rightItem = document.createElement('div');
                rightItem.className = 'correct-feedback-item';
                rightItem.style.backgroundImage = `url('${item.images.right}')`;
                
                correctFeedback.appendChild(leftItem);
                correctFeedback.appendChild(rightItem);
            } else {
                // For single items, show one item
                const singleItem = document.createElement('div');
                singleItem.className = 'correct-feedback-item';
                singleItem.style.backgroundImage = `url('${item.image}')`;
                correctFeedback.appendChild(singleItem);
            }
            
            // Show the overlay
            feedbackOverlay.style.display = 'flex';
            
            // Hide overlay after animation
            setTimeout(() => {
                feedbackOverlay.style.display = 'none';
            }, 2000);
        }

        // Start the next word
        function startNextWord() {
            if (currentItemIndex >= clothingItems.length) return;
            
            // Play pronunciation
            playClothingAudio(clothingItems[currentItemIndex].audio);
        }

        // Play clothing audio
        function playClothingAudio(audioUrl) {
            // Stop previous clothing audio if playing
            if (clothingAudio) {
                clothingAudio.pause();
                clothingAudio.currentTime = 0;
            }
            
            // Create new audio element
            clothingAudio = new Audio(audioUrl);
            clothingAudio.volume = Math.min(volumeSlider.value * 1.5, 1.0);
            
            // Add playing class to speaker
            clothingSpeaker.classList.add('playing');
            
            // Show arrow hint
            arrowHint.style.display = 'block';
            
            // Set flag to wait for answer
            isWaitingForAnswer = false;
            
            // When audio starts, set flag
            clothingAudio.addEventListener('play', () => {
                isWaitingForAnswer = true;
            });
            
            // When audio ends, remove playing class and hide arrow
            clothingAudio.addEventListener('ended', () => {
                clothingSpeaker.classList.remove('playing');
                arrowHint.style.display = 'none';
            });
            
            clothingAudio.play();
        }

        // Clear all flying items
        function clearFlyingItems() {
            // Remove all clothing elements from game area
            const clothingElements = gameArea.querySelectorAll('.clothing-item');
            clothingElements.forEach(element => {
                element.remove();
            });
            
            // Clear active items list
            activeItems = [];
        }

        // Start fireworks animation
        function startFireworks() {
            fireworksInterval = setInterval(createFirework, 300);
        }

        // Create a firework
        function createFirework() {
            const firework = document.createElement('div');
            firework.className = 'firework';
            
            // Random position
            const left = Math.random() * gameArea.offsetWidth;
            const top = Math.random() * gameArea.offsetHeight;
            firework.style.left = `${left}px`;
            firework.style.top = `${top}px`;
            
            // Random color
            const colors = ['#ff0000', '#00ff00', '#0000ff', '#ffff00', '#ff00ff', '#00ffff'];
            const color = colors[Math.floor(Math.random() * colors.length)];
            firework.style.backgroundColor = color;
            
            // Random size
            const size = 4 + Math.random() * 8;
            firework.style.width = `${size}px`;
            firework.style.height = `${size}px`;
            
            // Add to game area
            gameArea.appendChild(firework);
            
            // Remove after animation
            setTimeout(() => {
                if (firework.parentNode) {
                    gameArea.removeChild(firework);
                }
            }, 2000);
        }

        // Toggle background music
        function toggleBackgroundMusic() {
            if (!backgroundMusic) {
                // Create and play background music
                backgroundMusic = new Audio('videos/Untitled (24).mp3');
                backgroundMusic.loop = true;
                backgroundMusic.volume = volumeSlider.value;
                backgroundMusic.play();
                
                // Add playing class to speaker for animation
                speaker.classList.add('playing');
                
                // Show volume control
                volumeControl.classList.add('show');
            } else {
                // Stop music
                backgroundMusic.pause();
                backgroundMusic = null;
                
                // Remove playing class from speaker
                speaker.classList.remove('playing');
                
                // Hide volume control
                volumeControl.classList.remove('show');
            }
        }

        // Adjust volume
        function adjustVolume() {
            const volume = volumeSlider.value;
            
            if (backgroundMusic) {
                backgroundMusic.volume = volume;
            }
        }

        // Start the application
        window.addEventListener('DOMContentLoaded', init);
    </script>
