            .video-container {
                width: 70px;
                height: 105px;
            }
            
            .correct-feedback-item {
                width: 100px;
                height: 100px;
            }
            
            .item-name-feedback {
                font-size: 20px;
            }
            
            .clothing-speaker {
                width: 60px;
                height: 60px;
            }
            
            .arrow-hint {
                width: 35px;
                height: 35px;
                top: -50px;
            }
            
            .btn {
                padding: 5px 10px;
                font-size: 12px;
            }
            
            .game-container {
                margin-top: 80px;
            }
        }

        @media (max-width: 360px) {
            .game-area {
                height: 45vh;
            }
            
            .clothing-item {
                width: 60px;
                height: 60px;
            }
            
            .score {
                font-size: 16px;
            }
            
            .video-container {
                width: 60px;
                height: 90px;
            }
            
            .correct-feedback-item {
                width: 80px;
                height: 80px;
            }
            
            .item-name-feedback {
                font-size: 18px;
            }
            
            .clothing-speaker {
                width: 50px;
                height: 50px;
            }
            
            .arrow-hint {
                width: 30px;
                height: 30px;
                top: -45px;
            }
            
            .controls {
                flex-direction: column;
                gap: 10px;
            }
        }
    </style>
</head>
