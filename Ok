        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Georgia', serif;
            background: url('videos/IMG_20251122_225742_260.jpg') no-repeat center center fixed;
            background-size: cover;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 10px;
            overflow: hidden;
            color: #333;
            cursor: default;
        }

        .audio-control {
            position: fixed;
            top: 10px;
            right: 10px;
            z-index: 100;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }

        .speaker {
            width: 60px;
            height: 60px;
            cursor: pointer;
            transition: all 0.5s ease-in-out;
            filter: drop-shadow(0 0 5px rgba(255, 255, 255, 0.7));
        }

        .speaker:hover {
            transform: scale(1.1);
            filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.9));
        }

        .speaker.playing {
            animation: speakerPulse 2s ease-in-out infinite;
        }

        .volume-control {
            display: none;
            background: rgba(255, 255, 255, 0.8);
            padding: 5px 10px;
            border-radius: 20px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
            transition: all 0.3s ease;
        }

        .volume-control.show {
            display: block;
            animation: fadeIn 0.5s ease;
        }

        .clothing-audio-control {
            position: fixed;
            top: 10px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 100;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }

        .clothing-speaker {
            width: 80px;
            height: 80px;
            cursor: pointer;
            transition: all 0.5s ease-in-out;
            filter: drop-shadow(0 0 5px rgba(255, 255, 255, 0.7));
        }

        .clothing-speaker:hover {
            transform: scale(1.1);
            filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.9));
        }

        .clothing-speaker.playing {
            animation: speakerPulse 2s ease-in-out infinite;
        }

        .arrow-hint {
            position: absolute;
            top: -70px;
            left: 50%;
            transform: translateX(-50%);
            width: 50px;
            height: 50px;
            filter: drop-shadow(0 0 8px silver) drop-shadow(0 0 12px silver);
            animation: bounceArrow 2s infinite, neonPulse 1.5s infinite alternate;
            transition: all 0.3s ease;
        }

        .game-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 100%;
            max-width: 1200px;
            margin-top: 100px;
        }

        .game-info {
            background: rgba(255, 255, 255, 0.8);
            padding: 15px;
            border-radius: 15px;
            text-align: center;
            margin-bottom: 20px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
            width: 90%;
            max-width: 600px;
        }

        .score-container {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
            margin-bottom: 15px;
        }

        .score {
            font-size: 24px;
            font-weight: bold;
            color: #2c3e50;
            text-shadow: 0 0 10px #8a2be2, 0 0 20px #8a2be2, 0 0 30px #8a2be2;
            animation: scoreGlow 2s infinite alternate;
        }

        .video-container {
            width: 120px;
            height: 180px;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
            position: relative;
        }

        .video-container video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: top;
        }

        .controls {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 10px;
        }

        .btn {
            padding: 8px 16px;
            font-size: 16px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            background: #3498db;
            color: white;
            transition: all 0.3s;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .btn:hover {
            background: #2980b9;
            transform: translateY(-2px);
        }

        .btn:active {
            transform: translateY(1px);
        }

        .btn-restart {
            background: #e74c3c;
        }

        .btn-restart:hover {
            background: #c0392b;
        }

        .game-area {
            position: relative;
            width: 100%;
            height: 70vh;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.3);
        }

        .clothing-item {
            position: absolute;
            background-size: contain;
            background-repeat: no-repeat;
            background-position: center;
            cursor: pointer;
            transition: transform 0.3s, filter 0.5s;
            width: 100px;
            height: 100px;
            transform-origin: center;
            z-index: 10;
        }

        .clothing-item:hover {
            transform: scale(1.1);
        }

        .clothing-item.correct {
            animation: correctGlow 1.5s forwards;
        }

        .clothing-item.incorrect {
            animation: incorrectGlow 1.5s forwards;
        }

        .feedback-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: url('videos/IMG_20251128_230412_184.jpg') no-repeat center center;
            background-size: cover;
            z-index: 25;
            display: none;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            animation: fadeIn 0.5s ease;
        }

        .correct-feedback {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 30px;
            z-index: 30;
            margin-bottom: 30px;
        }

        .correct-feedback-item {
            width: 180px;
            height: 180px;
            background-size: contain;
            background-repeat: no-repeat;
            background-position: center;
            animation: correctFeedbackGlow 2s ease-in-out, float 2s ease-in-out infinite;
        }

        .item-name-feedback {
            font-size: 32px;
            font-weight: bold;
            color: white;
            text-shadow: 0 0 10px #00ff00, 0 0 20px #00ff00, 0 0 30px #00ff00;
            animation: textGlow 2s infinite alternate;
            text-align: center;
            padding: 10px 20px;
            border-radius: 10px;
            background: rgba(0, 0, 0, 0.5);
        }

        .firework {
            position: absolute;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            pointer-events: none;
            z-index: 5;
        }

        @keyframes flyAround {
            0% {
                transform: translate(0, 0) rotate(0deg);
            }
            25% {
                transform: translate(20vw, 15vh) rotate(90deg);
            }
            50% {
                transform: translate(-15vw, 25vh) rotate(180deg);
            }
            75% {
                transform: translate(10vw, -10vh) rotate(270deg);
            }
            100% {
                transform: translate(0, 0) rotate(360deg);
            }
        }

        @keyframes correctGlow {
            0% {
                filter: drop-shadow(0 0 5px #00ff00) drop-shadow(0 0 10px #00ff00);
            }
            50% {
                filter: drop-shadow(0 0 20px #00ff00) drop-shadow(0 0 30px #00ff00);
            }
            100% {
                filter: drop-shadow(0 0 5px #00ff00) drop-shadow(0 0 10px #00ff00);
                opacity: 1;
            }
        }

        @keyframes incorrectGlow {
            0% {
                filter: drop-shadow(0 0 5px #ff0000) drop-shadow(0 0 10px #ff0000);
            }
            50% {
                filter: drop-shadow(0 0 20px #ff0000) drop-shadow(0 0 30px #ff0000);
            }
            100% {
                filter: drop-shadow(0 0 5px #ff0000) drop-shadow(0 0 10px #ff0000);
                opacity: 1;
            }
        }

        @keyframes correctFeedbackGlow {
            0% {
                filter: drop-shadow(0 0 5px #00ff00) drop-shadow(0 0 10px #00ff00);
                transform: scale(1);
            }
            50% {
                filter: drop-shadow(0 0 25px #00ff00) drop-shadow(0 0 40px #00ff00);
                transform: scale(1.2);
            }
            100% {
                filter: drop-shadow(0 0 5px #00ff00) drop-shadow(0 0 10px #00ff00);
                transform: scale(1);
            }
        }

        @keyframes scoreGlow {
            0% {
                text-shadow: 0 0 10px #8a2be2, 0 0 20px #8a2be2, 0 0 30px #8a2be2;
            }
            100% {
                text-shadow: 0 0 15px #8a2be2, 0 0 25px #8a2be2, 0 0 35px #8a2be2;
            }
        }

        @keyframes textGlow {
            0% {
                text-shadow: 0 0 10px #00ff00, 0 0 20px #00ff00, 0 0 30px #00ff00;
            }
            100% {
                text-shadow: 0 0 15px #00ff00, 0 0 25px #00ff00, 0 0 35px #00ff00;
            }
        }

        @keyframes float {
            0%, 100% {
                transform: translateY(0);
            }
            50% {
                transform: translateY(-20px);
            }
        }

        @keyframes speakerPulse {
            0% {
                transform: scale(1);
                filter: drop-shadow(0 0 5px rgba(255, 255, 255, 0.7));
            }
            50% {
                transform: scale(1.15);
                filter: drop-shadow(0 0 15px rgba(255, 255, 255, 0.9));
            }
            100% {
                transform: scale(1);
                filter: drop-shadow(0 0 5px rgba(255, 255, 255, 0.7));
            }
        }

        @keyframes bounceArrow {
            0%, 100% { 
                transform: translateX(-50%) translateY(0); 
            }
            50% { 
                transform: translateX(-50%) translateY(-20px); 
            }
        }

        @keyframes neonPulse {
            from {
                filter: drop-shadow(0 0 5px silver) drop-shadow(0 0 10px silver);
            }
            to {
                filter: drop-shadow(0 0 10px silver) drop-shadow(0 0 20px silver) drop-shadow(0 0 30px silver);
            }
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        /* Mobile-first responsive design */
        @media (max-width: 768px) {
            .game-area {
                height: 60vh;
            }
            
            .clothing-item {
                width: 80px;
                height: 80px;
            }
            
            .score {
