            .correct-feedback-item {
                width: 130px;
                height: 130px;
            }
            
            .item-name-feedback {
                font-size: 24px;
            }
            
            .clothing-speaker {
                width: 70px;
                height: 70px;
            }
            
            .arrow-hint {
                width: 40px;
                height: 40px;
                top: -60px;
            }
            
            .btn {
                padding: 6px 12px;
                font-size: 14px;
            }
        }

        @media (max-width: 480px) {
            .game-area {
                height: 50vh;
            }
            
            .clothing-item {
                width: 70px;
                height: 70px;
            }
            
            .score {
                font-size: 18px;
